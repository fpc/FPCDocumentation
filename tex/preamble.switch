%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Extra preamble part that adds the menus for the page style and for the
% light or dark colours, and the sidebar with the contents of the manual.
% The makefile appends this to preamble.inc for every output except the chm
% help files. The contents list in fpc-toc.js is written by postproc.
%
\AtBeginDocument{%
\Configure{@HEAD}{\HCode{<script type="text/javascript" src="fpc-toc.js"></script>\Hnewline}}%
\Configure{@HEAD}{\HCode{<script type="text/javascript" src="fpc-theme-switch.js"></script>\Hnewline}}%
}%
% End.
%
